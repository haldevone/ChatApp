@{
    ViewData["Title"] = "Chat";
}

@model List<ChatApp.Models.ChatRoom>
@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/chat.css" />

<div class="rooms-wrapper">
    <div class="rooms-panel">
        <h5>Dina rum</h5>
        <div id="myRoomsList" class="rooms-badges">
            @foreach (var room in Model)
            {
                <span class="room-badge" data-room-name="@room.Name">@room.Name</span>
            }
        </div>

        <form id="createRoomForm">
            <input id="newRoomName" type="text" placeholder="Nytt rumsnamn" maxlength="50" />
            <button type="submit" class="btn-primary">Skapa rum</button>
        </form>

        <form id="addMemberForm">
            <input id="addMemberRoomId" type="number" placeholder="Rum-ID" />
            <input id="addMemberUserName" type="text" placeholder="Användarnamn att bjuda in" />
            <button type="submit" class="btn-primary">Lägg till medlem</button>
        </form>
    </div>
</div>

<div class="chat-wrapper">
    <div class="chat-container">
        <div class="chat-header">
            <h4>ChatApp</h4>
            <span class="logged-in-as">Inloggad som: <strong>@User.Identity?.Name</strong></span>
            <span id="connectionStatus" class="status-badge status-disconnected">Frånkopplad</span>
        </div>

        <div id="groupPanel" class="group-panel">
            <input id="groupNameInput" type="text" placeholder="Gruppnamn (t.ex. allmänt)" maxlength="50" />
            <button id="joinGroupBtn" class="btn-primary">Anslut</button>
        </div>

        <div class="active-group-box" id="activeGroupBox" style="display:none;">
            <span class="active-group-name" id="activeGroupName"></span>
            <button id="leaveGroupBtn" class="btn-leave">Lämna grupp</button>
        </div>

        <div id="messagesBox" class="messages-box">
            <div class="empty-state">Anslut till en grupp för att börja chatta</div>
        </div>

        <div id="typingIndicator" class="typing-indicator"></div>

        <div class="members-panel" id="membersPanel" style="display:none;">
            <span class="members-label">I gruppen:</span>
            <span id="membersList"></span>
        </div>

        <div class="message-input-panel">
            <input id="messageInput" type="text" placeholder="Skriv ett meddelande..." maxlength="500" disabled />
            <button id="sendBtn" class="btn-primary" disabled>Skicka</button>
        </div>
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    const currentUserName = "@User.Identity?.Name";
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
</script>
<script src="~/js/chat.js"></script>
